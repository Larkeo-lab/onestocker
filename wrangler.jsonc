{
  // ทางสำรองตอน Cloudflare Pages มีปัญหา — deploy ไฟล์นิ่งเป็น Worker แทน
  //
  //   pnpm dlx wrangler deploy
  //
  // ใช้คนละ endpoint กับ Pages (/pages/assets/upload) จึงไม่พังตามกัน
  // ผลลัพธ์ที่ผู้ใช้เห็นเหมือนกันทุกอย่าง — ไฟล์นิ่งเสิร์ฟผ่าน CDN ของ Cloudflare
  "name": "one-stock",
  "compatibility_date": "2026-09-10",

  // ผูกโดเมนจากไฟล์นี้แทนการกดในหน้า dashboard
  //
  // custom_domain: true สั่งให้ Cloudflare สร้าง DNS record กับใบรับรอง
  // ให้เองอัตโนมัติ โดเมนต้องอยู่ในบัญชี Cloudflare เดียวกันกับ Worker
  //
  // ตั้งไว้ที่นี่แล้วมันถูกใช้ซ้ำทุกครั้งที่ deploy ไม่ต้องกลับไปกดใหม่
  // และเห็นได้จากโค้ดว่าแอปนี้อยู่โดเมนไหน
  "routes": [
    { "pattern": "stockphoto-metadata.eezypos.com", "custom_domain": true }
  ],

  // เก็บ URL .workers.dev ไว้ด้วย ใช้ทดสอบตอนโดเมนหลักมีปัญหา
  "workers_dev": true,

  "assets": {
    "directory": "./dist",

    // เส้นทางทั้งหมดถูกจัดการโดย react-router ในเบราว์เซอร์
    // ไม่ได้มีไฟล์จริงชื่อ /settings อยู่ ถ้าไม่ตั้งค่านี้การเปิด URL ตรง ๆ
    // หรือกดรีเฟรชจะได้ 404
    //
    // ห้ามมีไฟล์ public/_redirects คู่กับตัวเลือกนี้ — ทั้งสองทำหน้าที่
    // เดียวกัน Workers จะมองว่ากฎวนกลับหาตัวเองแล้วปฏิเสธตอน deploy
    "not_found_handling": "single-page-application"
  }
}
