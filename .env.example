# base URL ของ Go (Fiber) API — ไม่ต้องมี / ปิดท้าย
VITE_API_URL=http://localhost:8080/api

# publishable key ของ Clerk (เป็น public โดยตั้งใจ)
# secret key อยู่ฝั่ง Go เท่านั้น ห้ามใส่ที่นี่
# ใช้ pk_test_ ของ development instance ถ้าจะล็อกอินจาก localhost
VITE_CLERK_PUBLISHABLE_KEY=

# "true" = ข้ามหน้าล็อกอินตอนพัฒนา (ทำงานเฉพาะ dev)
# ต้องตั้ง AUTH_DEV_BYPASS=true ฝั่ง server คู่กัน
VITE_AUTH_DEV_BYPASS=false
