# คัดลอกเป็น .env (สำหรับเครื่องตัวเอง) และ .env.production (สำหรับ EC2)
# ทั้งสองไฟล์ห้าม commit
#
# อย่าสลับค่าด้วยการคอมเมนต์ในไฟล์เดียว — คีย์ Clerk ต้องเข้าคู่กับ
# ฝั่งหน้าเว็บด้วย ถ้าแก้ไม่ครบทั้งสองที่จะกลายเป็นคนละ instance แล้วได้ 401

# development | production
# production จะบังคับให้ตัวแปรครบ และห้ามเปิด AUTH_DEV_BYPASS
APP_ENV=development
PORT=8080

# โดเมนของหน้าเว็บที่ยิงเข้ามาได้ คั่นด้วยจุลภาค
ALLOWED_ORIGINS=http://localhost:5173

# Neon (Postgres) — ใช้ connection string แบบ pooled
DATABASE_URL=

# ข้ามการตรวจ token ระหว่างพัฒนา นับทุกคำขอเป็นผู้ใช้สมมติ
# ต้องตั้ง VITE_AUTH_DEV_BYPASS ให้ตรงกันฝั่งหน้าเว็บ
AUTH_DEV_BYPASS=false

# Clerk user id ที่จะสวมตอนเปิด AUTH_DEV_BYPASS ว่างไว้ = dev-user
AUTH_DEV_USER_ID=

# Clerk — secret key เท่านั้น publishable key อยู่ฝั่งหน้าเว็บ
#   .env            ใช้ sk_test_ (instance development)
#   .env.production ใช้ sk_live_ (instance production)
CLERK_SECRET_KEY=

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Cloudflare R2 (S3-compatible)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PRESIGN_TTL_SECONDS=900
