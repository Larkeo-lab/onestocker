# คัดลอกเป็น .env แล้วเติมค่า — .env ห้าม commit
APP_ENV=development
PORT=8080

# โดเมนของหน้าเว็บที่ยิงเข้ามาได้ คั่นด้วยจุลภาค
# ตอนมีเว็บแอดมินให้เติมเข้ามาอีกตัว
ALLOWED_ORIGINS=http://localhost:5173

# Neon (Postgres) — ใช้ connection string แบบ pooled
DATABASE_URL=

# ข้ามการตรวจ token ระหว่างพัฒนา นับทุกคำขอเป็นผู้ใช้ dev-user
# เปิดบน production ไม่ได้ — config.Load จะไม่ยอมให้เซิร์ฟเวอร์สตาร์ท
AUTH_DEV_BYPASS=false

# Clerk — เอา secret key เท่านั้น ห้ามเอา publishable key มาไว้ที่นี่
CLERK_SECRET_KEY=

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Cloudflare R2 (S3-compatible)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PRESIGN_TTL_SECONDS=900
