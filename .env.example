# คัดลอกเป็น .env (สำหรับเครื่องตัวเอง) และ .env.production (ใช้ตอน build)
# vite อ่าน .env.production ให้เองเมื่อรัน `vite build` ไม่ต้องสั่งอะไรเพิ่ม

VITE_API_URL=http://localhost:8080/api

# Clerk — คีย์นี้เป็น public โดยตั้งใจ ถูกฝังลงไฟล์ JS อยู่แล้ว
# ต้องเป็น instance เดียวกับ CLERK_SECRET_KEY ฝั่ง server
#   .env            ใช้ pk_test_ (instance development — อนุญาต localhost)
#   .env.production ใช้ pk_live_ (instance production — ปฏิเสธ localhost)
VITE_CLERK_PUBLISHABLE_KEY=

# "true" = ข้ามหน้าล็อกอินตอนพัฒนา (ทำงานเฉพาะ dev)
# ต้องตั้ง AUTH_DEV_BYPASS ให้ตรงกันฝั่ง server
VITE_AUTH_DEV_BYPASS=false
